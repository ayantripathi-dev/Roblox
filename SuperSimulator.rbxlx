    <Item class="StarterPlayerScripts" referent="36">
      <Properties>
        <string name="Name">StarterPlayerScripts</string>
      </Properties>
      <Item class="LocalScript" referent="37">
        <Properties>
          <string name="Name">Client</string>
          <string name="Source"><![CDATA[local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local HUD = require(script.HUD)
local PetFollow = require(script.PetFollow)
local ClickEffect = require(script.ClickEffect)

local Events = ReplicatedStorage:WaitForChild("Events")
local ClickEvent = Events:WaitForChild("ClickEvent")
local RebirthEvent = Events:WaitForChild("RebirthEvent")

local player = Players.LocalPlayer
local playerGui = player:WaitForChild("PlayerGui")
local mainHUD = playerGui:WaitForChild("MainHUD")

local buttons = mainHUD:WaitForChild("Buttons")
local clickButton = buttons:WaitForChild("ClickButton")
local rebirthButton = buttons:WaitForChild("RebirthButton")
local upgradeButton = buttons:WaitForChild("UpgradeButton")
local petButton = buttons:WaitForChild("PetButton")

HUD.init()
PetFollow.init()

clickButton.MouseButton1Click:Connect(function()
	ClickEvent:FireServer()
end)

Events:WaitForChild("PowerGainedEvent").OnClientEvent:Connect(function(amount)
	ClickEffect.create(amount)
end)

rebirthButton.MouseButton1Click:Connect(function()
	RebirthEvent:FireServer()
end)

upgradeButton.MouseButton1Click:Connect(function()
	Events.UpgradeEvent:FireServer("Power") -- Simple toggle for demo
end)

petButton.MouseButton1Click:Connect(function()
	Events.PetHatchEvent:FireServer()
end)

local unlockZoneButton = Instance.new("TextButton")
unlockZoneButton.Name = "UnlockZoneButton"
unlockZoneButton.Size = UDim2.new(0, 200, 0, 50)
unlockZoneButton.Position = UDim2.new(0.5, -100, 0, 160)
unlockZoneButton.Text = "Unlock Next Zone"
unlockZoneButton.Parent = mainHUD:WaitForChild("HUDFrame")

unlockZoneButton.MouseButton1Click:Connect(function()
	Events.UnlockZoneEvent:FireServer()
end)

Events:WaitForChild("PetEquippedEvent").OnClientEvent:Connect(function(equippedPets)
	PetFollow.updatePets(equippedPets)
end)

print("Client initialized.")
]]></string>
        </Properties>
        <Item class="ModuleScript" referent="38">
          <Properties>
            <string name="Name">ClickEffect</string>
            <string name="Source"><![CDATA[local Players = game:GetService("Players")
local TweenService = game:GetService("TweenService")
local player = Players.LocalPlayer

local ClickEffect = {}

function ClickEffect.create(amount)
	local character = player.Character
	if not character then return end
	local rootPart = character:FindFirstChild("HumanoidRootPart")
	if not rootPart then return end

	local billboard = Instance.new("BillboardGui")
	billboard.Size = UDim2.new(2, 0, 1, 0)
	billboard.Adornee = rootPart
	billboard.StudsOffset = Vector3.new(math.random(-2, 2), 2, math.random(-2, 2))
	billboard.Parent = character

	local label = Instance.new("TextLabel")
	label.Size = UDim2.new(1, 0, 1, 0)
	label.BackgroundTransparency = 1
	label.Text = "+" .. amount
	label.TextColor3 = Color3.fromRGB(255, 255, 255)
	label.TextScaled = true
	label.Font = Enum.Font.GothamBold
	label.Parent = billboard

	local tweenInfo = TweenInfo.new(0.5, Enum.EasingStyle.Quart, Enum.EasingDirection.Out)
	local tween = TweenService:Create(billboard, tweenInfo, {StudsOffset = billboard.StudsOffset + Vector3.new(0, 3, 0)})

	task.spawn(function()
		tween:Play()
		task.wait(0.5)
		for i = 0, 1, 0.1 do
			label.TextTransparency = i
			task.wait(0.05)
		end
		billboard:Destroy()
	end)
end

return ClickEffect
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="39">
          <Properties>
            <string name="Name">HUD</string>
            <string name="Source"><![CDATA[local Players = game:GetService("Players")
local player = Players.LocalPlayer
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Utils = require(ReplicatedStorage.Shared.Utils)
local HUD = {}

function HUD.init()
	local playerGui = player:WaitForChild("PlayerGui")
	local mainHUD = playerGui:WaitForChild("MainHUD")
	local hudFrame = mainHUD:WaitForChild("HUDFrame")
	local powerLabel = hudFrame:WaitForChild("PowerLabel")
	local coinsLabel = hudFrame:WaitForChild("CoinsLabel")

	local zoneLabel = Instance.new("TextLabel")
	zoneLabel.Name = "ZoneLabel"
	zoneLabel.Size = UDim2.new(0, 200, 0, 50)
	zoneLabel.Position = UDim2.new(0.5, -100, 0, 100)
	zoneLabel.Text = "Zone: Zone 1"
	zoneLabel.Parent = hudFrame

	local leaderstats = player:WaitForChild("leaderstats")
	local powerStat = leaderstats:WaitForChild("Power")
	local coinsStat = leaderstats:WaitForChild("Coins")

	local function update()
		powerLabel.Text = "Power: " .. Utils.formatNumber(powerStat.Value)
		coinsLabel.Text = "Coins: " .. Utils.formatNumber(coinsStat.Value)
	end

	powerStat.Changed:Connect(update)
	coinsStat.Changed:Connect(update)

	ReplicatedStorage:WaitForChild("Events"):WaitForChild("ZoneChangedEvent").OnClientEvent:Connect(function(zoneName)
		zoneLabel.Text = "Zone: " .. zoneName
	end)

	update()
end

return HUD
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="40">
          <Properties>
            <string name="Name">PetFollow</string>
            <string name="Source"><![CDATA[local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local PetFollow = {}
local activePets = {}

function PetFollow.init()
	local player = Players.LocalPlayer

	RunService.RenderStepped:Connect(function()
		local character = player.Character
		if not character then return end
		local rootPart = character:FindFirstChild("HumanoidRootPart")
		if not rootPart then return end

		for i, petModel in ipairs(activePets) do
			local targetPos = rootPart.Position + Vector3.new(
				math.sin(tick() + i) * 5,
				2 + math.sin(tick() * 2 + i) * 0.5,
				math.cos(tick() + i) * 5
			)
			petModel.CFrame = petModel.CFrame:Lerp(CFrame.new(targetPos, rootPart.Position), 0.1)
		end
	end)
end

function PetFollow.updatePets(pets)
	-- Clear existing
	for _, p in ipairs(activePets) do
		p:Destroy()
	end
	activePets = {}

	for _, petData in ipairs(pets) do
		local part = Instance.new("Part")
		part.Size = Vector3.new(2, 2, 2)
		part.Anchored = true
		part.CanCollide = false
		part.Parent = workspace
		part.Name = "Pet_" .. petData.Name

		-- Simple visual based on rarity
		if petData.Rarity == "Common" then
			part.Color = Color3.fromRGB(200, 200, 200)
		elseif petData.Rarity == "Legendary" then
			part.Color = Color3.fromRGB(255, 215, 0)
		else
			part.Color = Color3.fromRGB(100, 200, 255)
		end

		table.insert(activePets, part)
	end
end

return PetFollow
]]></string>
          </Properties>
        </Item>
      </Item>
