      <Item class="LocalScript" referent="44">
        <Properties>
          <string name="Name">Client</string>
          <string name="Source">local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local HUD = require(script.HUD)
local PetInventory = require(script.PetInventory)
local UpgradeMenu = require(script.UpgradeMenu)
local ClickEffect = require(script.ClickEffect)
local PetFollow = require(script.PetFollow)

local Events = ReplicatedStorage:WaitForChild("Events")
local ClickEvent = Events:WaitForChild("ClickEvent")
local RebirthEvent = Events:WaitForChild("RebirthEvent")
local PetHatchFunction = Events:WaitForChild("PetHatchFunction")
local UnlockZoneEvent = Events:WaitForChild("UnlockZoneEvent")
local RequestDataEvent = Events:WaitForChild("RequestDataEvent")

local player = Players.LocalPlayer
local playerGui = player:WaitForChild("PlayerGui")
local mainHUD = playerGui:WaitForChild("MainHUD")

local function setupUI()
	local hudFrame = mainHUD:WaitForChild("HUDFrame")
	hudFrame.Size = UDim2.new(0, 200, 0, 100)
	hudFrame.Position = UDim2.new(0, 10, 0, 10)
	hudFrame.BackgroundTransparency = 0.5

	local powerLabel = hudFrame:WaitForChild("PowerLabel")
	powerLabel.Size = UDim2.new(1, 0, 0.5, 0)
	powerLabel.TextScaled = true

	local coinsLabel = hudFrame:WaitForChild("CoinsLabel")
	coinsLabel.Size = UDim2.new(1, 0, 0.5, 0)
	coinsLabel.Position = UDim2.new(0, 0, 0.5, 0)
	coinsLabel.TextScaled = true

	local buttons = mainHUD:WaitForChild("Buttons")
	local clickButton = buttons:WaitForChild("ClickButton")
	clickButton.Size = UDim2.new(0, 200, 0, 50)
	clickButton.Position = UDim2.new(0.5, -100, 0.8, 0)
	clickButton.BackgroundColor3 = Color3.fromRGB(0, 178, 0)
	clickButton.TextScaled = true

	local rebirthButton = buttons:WaitForChild("RebirthButton")
	rebirthButton.Size = UDim2.new(0, 150, 0, 40)
	rebirthButton.Position = UDim2.new(0.5, -75, 0.8, 60)
	rebirthButton.BackgroundColor3 = Color3.fromRGB(178, 0, 178)
	rebirthButton.TextScaled = true

	local upgradeButton = buttons:WaitForChild("UpgradeButton")
	upgradeButton.Size = UDim2.new(0, 100, 0, 40)
	upgradeButton.Position = UDim2.new(1, -110, 0.9, 0)
	upgradeButton.BackgroundColor3 = Color3.fromRGB(178, 178, 0)
	upgradeButton.TextScaled = true

	local petButton = buttons:WaitForChild("PetButton")
	petButton.Size = UDim2.new(0, 100, 0, 40)
	petButton.Position = UDim2.new(1, -110, 0.9, -50)
	petButton.BackgroundColor3 = Color3.fromRGB(0, 178, 178)
	petButton.TextScaled = true

	local autoToggle = buttons:WaitForChild("AutoClickToggle")
	autoToggle.Size = UDim2.new(0, 100, 0, 40)
	autoToggle.Position = UDim2.new(0, 10, 0.9, 0)
	autoToggle.BackgroundColor3 = Color3.fromRGB(100, 100, 100)
	autoToggle.TextScaled = true

	local petInv = mainHUD:WaitForChild("PetInventory")
	petInv.Size = UDim2.new(0, 400, 0, 300)
	petInv.Position = UDim2.new(0.5, -200, 0.5, -150)
	petInv.Visible = false
	petInv:WaitForChild("Title").Size = UDim2.new(1, 0, 0, 50)
	petInv.Title.TextScaled = true

	local upgMenu = mainHUD:WaitForChild("UpgradeMenu")
	upgMenu.Size = UDim2.new(0, 300, 0, 400)
	upgMenu.Position = UDim2.new(0.5, -150, 0.5, -200)
	upgMenu.Visible = false
	upgMenu:WaitForChild("Title").Size = UDim2.new(1, 0, 0, 50)
	upgMenu.Title.TextScaled = true
end

setupUI()

HUD.init()
PetInventory.init()
UpgradeMenu.init()
PetFollow.init()

local buttons = mainHUD:WaitForChild("Buttons")
local clickButton = buttons:WaitForChild("ClickButton")
local rebirthButton = buttons:WaitForChild("RebirthButton")
local upgradeButton = buttons:WaitForChild("UpgradeButton")
local petButton = buttons:WaitForChild("PetButton")
local autoToggle = buttons:WaitForChild("AutoClickToggle")

clickButton.MouseButton1Click:Connect(function()
	ClickEvent:FireServer()
	ClickEffect.show(1)
end)

rebirthButton.MouseButton1Click:Connect(function()
	RebirthEvent:FireServer()
end)

upgradeButton.MouseButton1Click:Connect(function()
	UpgradeMenu.toggle()
end)

petButton.MouseButton1Click:Connect(function()
	PetInventory.toggle()
end)

local autoClickOn = false
autoToggle.MouseButton1Click:Connect(function()
	autoClickOn = not autoClickOn
	autoToggle.Text = "AUTO: " .. (autoClickOn and "ON" or "OFF")
	autoToggle.BackgroundColor3 = autoClickOn and Color3.fromRGB(0, 200, 0) or Color3.fromRGB(100, 100, 100)
end)

task.spawn(function()
	while true do
		if autoClickOn then
			ClickEvent:FireServer()
			ClickEffect.show(1)
		end
		task.wait(0.5)
	end
end)

-- Workspace logic
local Workspace = game:GetService("Workspace")
local HatchArea = Workspace:WaitForChild("HatchArea")
local Zone2 = Workspace:WaitForChild("Zone2")
local Gate = Zone2:WaitForChild("Gate")
local GoldEggArea = Zone2:WaitForChild("GoldEggArea")

local hatchDebounce = false
HatchArea.Touched:Connect(function(hit)
	if hit.Parent == player.Character and not hatchDebounce then
		hatchDebounce = true
		local pet = PetHatchFunction:InvokeServer("Basic")
		if pet then
			print("Hatched: " .. pet.Name)
			RequestDataEvent:FireServer()
		end
		task.wait(1)
		hatchDebounce = false
	end
end)

GoldEggArea.Touched:Connect(function(hit)
	if hit.Parent == player.Character and not hatchDebounce then
		hatchDebounce = true
		local pet = PetHatchFunction:InvokeServer("Golden")
		if pet then
			print("Hatched Golden: " .. pet.Name)
			RequestDataEvent:FireServer()
		end
		task.wait(1)
		hatchDebounce = false
	end
end)

Gate.Touched:Connect(function(hit)
	if hit.Parent == player.Character then
		UnlockZoneEvent:FireServer("Zone2")
	end
end)

RequestDataEvent.OnClientEvent:Connect(function(data)
	if data.UnlockedZones and data.UnlockedZones.Zone2 then
		Gate.CanCollide = false
		Gate.Transparency = 0.9
	end
	if data.EquippedPets then
		PetFollow.updatePets(data.EquippedPets, data.Pets)
	end
end)

print("Client initialized.")</string>
        </Properties>
        <Item class="ModuleScript" referent="45">
          <Properties>
            <string name="Name">ClickEffect</string>
            <string name="Source">local TweenService = game:GetService("TweenService")
local Players = game:GetService("Players")
local player = Players.LocalPlayer

local ClickEffect = {}

function ClickEffect.show(amount)
	local playerGui = player:WaitForChild("PlayerGui")
	local mainHUD = playerGui:WaitForChild("MainHUD")

	local label = Instance.new("TextLabel")
	label.Text = "+" .. amount
	label.Size = UDim2.new(0, 50, 0, 20)
	label.Position = UDim2.new(0.5, math.random(-50, 50), 0.5, math.random(-50, 50))
	label.TextColor3 = Color3.new(0, 1, 0)
	label.BackgroundTransparency = 1
	label.Parent = mainHUD

	local goal = {
		Position = label.Position - UDim2.new(0, 0, 0.1, 0),
		TextTransparency = 1
	}

	local info = TweenInfo.new(1)
	local tween = TweenService:Create(label, info, goal)

	tween:Play()
	tween.Completed:Connect(function()
		label:Destroy()
	end)
end

return ClickEffect</string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="46">
          <Properties>
            <string name="Name">HUD</string>
            <string name="Source">local Players = game:GetService("Players")
local player = Players.LocalPlayer
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Utils = require(ReplicatedStorage.Shared.Utils)
local HUD = {}

function HUD.init()
	local playerGui = player:WaitForChild("PlayerGui")
	local mainHUD = playerGui:WaitForChild("MainHUD")
	local hudFrame = mainHUD:WaitForChild("HUDFrame")
	local powerLabel = hudFrame:WaitForChild("PowerLabel")
	local coinsLabel = hudFrame:WaitForChild("CoinsLabel")

	local leaderstats = player:WaitForChild("leaderstats")
	local powerStat = leaderstats:WaitForChild("Power")
	local coinsStat = leaderstats:WaitForChild("Coins")

	local function update()
		powerLabel.Text = "Power: " .. Utils.formatNumber(powerStat.Value)
		coinsLabel.Text = "Coins: " .. Utils.formatNumber(coinsStat.Value)
	end

	powerStat.Changed:Connect(update)
	coinsStat.Changed:Connect(update)
	update()
end

return HUD</string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="47">
          <Properties>
            <string name="Name">PetFollow</string>
            <string name="Source">local RunService = game:GetService("RunService")
local Players = game:GetService("Players")
local player = Players.LocalPlayer

local PetFollow = {}
local activePets = {}

function PetFollow.init()
	RunService.RenderStepped:Connect(function()
		if not player.Character or not player.Character:FindFirstChild("HumanoidRootPart") then return end
		local root = player.Character.HumanoidRootPart

		for i, petModel in ipairs(activePets) do
			local targetPos = root.Position + Vector3.new(
				math.sin(tick() + i) * 5,
				math.sin(tick() * 2) * 1,
				math.cos(tick() + i) * 5
			)
			petModel.CFrame = petModel.CFrame:Lerp(CFrame.new(targetPos, root.Position), 0.1)
		end
	end)
end

function PetFollow.updatePets(equippedData, allPets)
	-- Clear old
	for _, pet in ipairs(activePets) do
		pet:Destroy()
	end
	activePets = {}

	for _, petId in ipairs(equippedData) do
		local petData
		for _, p in ipairs(allPets) do
			if p.Id == petId then
				petData = p
				break
			end
		end

		if petData then
			local model = Instance.new("Part")
			model.Size = Vector3.new(2, 2, 2)
			model.CanCollide = false
			model.Anchored = true
			model.Color = Color3.fromHSV(math.random(), 0.5, 1)
			model.Parent = workspace

			local bg = Instance.new("BillboardGui")
			bg.Size = UDim2.new(4, 0, 1, 0)
			bg.StudsOffset = Vector3.new(0, 3, 0)
			bg.AlwaysOnTop = true
			bg.Parent = model

			local label = Instance.new("TextLabel")
			label.Size = UDim2.new(1, 0, 1, 0)
			label.BackgroundTransparency = 1
			label.Text = petData.Name
			label.TextColor3 = Color3.new(1, 1, 1)
			label.TextScaled = true
			label.Parent = bg

			table.insert(activePets, model)
		end
	end
end

return PetFollow</string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="48">
          <Properties>
            <string name="Name">PetInventory</string>
            <string name="Source">local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Events = ReplicatedStorage:WaitForChild("Events")
local player = Players.LocalPlayer

local PetInventory = {}
local mainFrame

function PetInventory.init()
	local playerGui = player:WaitForChild("PlayerGui")
	local mainHUD = playerGui:WaitForChild("MainHUD")
	mainFrame = mainHUD:WaitForChild("PetInventory")
	local petList = mainFrame:WaitForChild("PetList")

	Events.RequestDataEvent.OnClientEvent:Connect(function(data)
		PetInventory.refresh(data)
	end)
end

function PetInventory.toggle()
	mainFrame.Visible = not mainFrame.Visible
	if mainFrame.Visible then
		Events.RequestDataEvent:FireServer()
	end
end

function PetInventory.refresh(data)
	local petList = mainFrame.PetList
	for _, child in ipairs(petList:GetChildren()) do
		if child:IsA("TextButton") then
			child:Destroy()
		end
	end

	local pets = data.Pets or {}
	local equipped = data.EquippedPets or {}

	for _, pet in ipairs(pets) do
		local button = Instance.new("TextButton")
		button.Name = pet.Id
		button.Size = UDim2.new(0, 80, 0, 80)

		local isEquipped = false
		for _, eqId in ipairs(equipped) do
			if eqId == pet.Id then
				isEquipped = true
				break
			end
		end

		button.Text = pet.Name .. "\n" .. (isEquipped and "[EQUIPPED]" or "")
		button.Parent = petList

		button.MouseButton1Click:Connect(function()
			Events.PetEquipEvent:FireServer(pet.Id, not isEquipped)
		end)
	end
end

return PetInventory</string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="49">
          <Properties>
            <string name="Name">UpgradeMenu</string>
            <string name="Source">local ReplicatedStorage = game:GetService("ReplicatedStorage")
local UpgradesConfig = require(ReplicatedStorage.Shared.Upgrades)
local Events = ReplicatedStorage:WaitForChild("Events")
local Players = game:GetService("Players")
local player = Players.LocalPlayer

local UpgradeMenu = {}
local mainFrame

function UpgradeMenu.init()
	local playerGui = player:WaitForChild("PlayerGui")
	local mainHUD = playerGui:WaitForChild("MainHUD")
	mainFrame = mainHUD:WaitForChild("UpgradeMenu")

	Events.RequestDataEvent.OnClientEvent:Connect(function(data)
		UpgradeMenu.refresh(data)
	end)
end

function UpgradeMenu.toggle()
	mainFrame.Visible = not mainFrame.Visible
	if mainFrame.Visible then
		Events.RequestDataEvent:FireServer()
	end
end

function UpgradeMenu.refresh(data)
	local list = mainFrame.List
	for _, child in ipairs(list:GetChildren()) do
		if child:IsA("TextButton") then
			child:Destroy()
		end
	end

	local playerUpgrades = data.Upgrades or {Power = 1, Coins = 1}

	for upgradeType, levels in pairs(UpgradesConfig) do
		local currentLevel = playerUpgrades[upgradeType]
		local nextLevelData = levels[currentLevel + 1]

		local button = Instance.new("TextButton")
		button.Name = upgradeType
		button.Size = UDim2.new(1, 0, 0, 50)

		if nextLevelData then
			button.Text = string.format("Upgrade %s to Lvl %d (Cost: %d)", upgradeType, currentLevel + 1, nextLevelData.Cost)
		else
			button.Text = upgradeType .. " (MAX LEVEL)"
		end

		button.Parent = list

		button.MouseButton1Click:Connect(function()
			Events.UpgradeEvent:FireServer(upgradeType)
		end)
	end
end

return UpgradeMenu</string>
          </Properties>
        </Item>
      </Item>
    </Item>
