  <Item class="ServerScriptService" referent="17">
    <Properties>
      <string name="Name">ServerScriptService</string>
    </Properties>
    <Item class="Script" referent="18">
      <Properties>
        <string name="Name">Server</string>
        <token name="RunContext">0</token>
        <string name="Source"><![CDATA[local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Leaderstats = require(script.Leaderstats)
local GameService = require(script.GameService)
local MarketplaceManager = require(script.MarketplaceManager)

local Events = ReplicatedStorage:WaitForChild("Events")
local ClickEvent = Events:WaitForChild("ClickEvent")
local RebirthEvent = Events:WaitForChild("RebirthEvent")
local UpgradeEvent = Events:WaitForChild("UpgradeEvent")
local PetHatchEvent = Events:WaitForChild("PetHatchEvent")

local PetService = require(script.PetService)
local DataManager = require(script.DataManager)
local Upgrades = require(ReplicatedStorage.Shared.Upgrades)

Players.PlayerAdded:Connect(function(player)
	Leaderstats.initialize(player)
end)

ClickEvent.OnServerEvent:Connect(function(player)
	GameService.handleClick(player)
end)

RebirthEvent.OnServerEvent:Connect(function(player)
	GameService.handleRebirth(player)
end)

UpgradeEvent.OnServerEvent:Connect(function(player, upgradeType)
	local data = DataManager.get(player, "Upgrades")
	local currentLevel = data[upgradeType]
	local nextLevel = currentLevel + 1

	if Upgrades[upgradeType][nextLevel] then
		local cost = Upgrades[upgradeType][nextLevel].Cost
		local coins = DataManager.get(player, "Coins")
		if coins >= cost then
			DataManager.increment(player, "Coins", -cost)
			data[upgradeType] = nextLevel
			DataManager.set(player, "Upgrades", data)
			Leaderstats.update(player, "Coins", DataManager.get(player, "Coins"))
		end
	end
end)

PetHatchEvent.OnServerEvent:Connect(function(player)
	PetService.hatch(player)
end)

-- Sell part logic
local Workspace = game:GetService("Workspace")
local SellPart = Workspace:WaitForChild("SellPart")

SellPart.Touched:Connect(function(hit)
	local character = hit.Parent
	local player = Players:GetPlayerFromCharacter(character)
	if player then
		GameService.handleSell(player)
	end
end)

print("Server initialized.")
]]></string>
      </Properties>
      <Item class="ModuleScript" referent="19">
        <Properties>
          <string name="Name">DataManager</string>
          <string name="Source"><![CDATA[local DataStoreService = game:GetService("DataStoreService")
local PlayerDataStore = DataStoreService:GetDataStore("PlayerData_v1")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Constants = require(ReplicatedStorage.Shared.Constants)

local DataManager = {}
local sessionData = {}

function DataManager.loadData(player)
	local success, result = pcall(function()
		return PlayerDataStore:GetAsync(tostring(player.UserId))
	end)

	if success then
		sessionData[player.UserId] = result or {
			Power = Constants.INITIAL_POWER,
			Coins = Constants.INITIAL_COINS,
			Rebirths = Constants.INITIAL_REBIRTHS,
			Upgrades = {Power = 1, Coins = 1},
			Pets = {},
			EquippedPets = {},
			UnlockedZones = {"Zone 1"},
			CurrentZone = "Zone 1"
		}
		return sessionData[player.UserId]
	else
		warn("Failed to load data for player " .. player.Name .. ": " .. tostring(result))
		return nil
	end
end

function DataManager.saveData(player)
	if sessionData[player.UserId] then
		local success, result = pcall(function()
			PlayerDataStore:UpdateAsync(tostring(player.UserId), function(oldData)
				return sessionData[player.UserId]
			end)
		end)
		if not success then
			warn("Failed to save data for player " .. player.Name .. ": " .. tostring(result))
		end
	end
end

game:BindToClose(function()
	for _, player in ipairs(game:GetService("Players"):GetPlayers()) do
		DataManager.saveData(player)
	end
end)

function DataManager.get(player, key)
	if sessionData[player.UserId] then
		return sessionData[player.UserId][key]
	end
end

function DataManager.set(player, key, value)
	if sessionData[player.UserId] then
		sessionData[player.UserId][key] = value
	end
end

function DataManager.increment(player, key, amount)
	if sessionData[player.UserId] then
		sessionData[player.UserId][key] = (sessionData[player.UserId][key] or 0) + amount
	end
end

game:GetService("Players").PlayerRemoving:Connect(function(player)
	DataManager.saveData(player)
	sessionData[player.UserId] = nil
end)

return DataManager
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="20">
        <Properties>
          <string name="Name">GameService</string>
          <string name="Source"><![CDATA[local ReplicatedStorage = game:GetService("ReplicatedStorage")
local DataManager = require(script.Parent.DataManager)
local Leaderstats = require(script.Parent.Leaderstats)
local PetService = require(script.Parent.PetService)
local ZoneService = require(script.Parent.ZoneService)
local Constants = require(ReplicatedStorage.Shared.Constants)
local Upgrades = require(ReplicatedStorage.Shared.Upgrades)

local GameService = {}

function GameService.handleClick(player)
	local rebirths = DataManager.get(player, "Rebirths") or 0
	local upgradeLevel = (DataManager.get(player, "Upgrades") or {Power = 1}).Power
	local upgradeMult = Upgrades.Power[upgradeLevel].Multiplier
	local petMult = PetService.getEquippedMultiplier(player)
	local zoneMult = ZoneService.getMultiplier(player)

	local gain = Constants.CLICK_POWER_GAIN * (rebirths + 1) * upgradeMult * petMult * zoneMult

	local amount = math.floor(gain)
	DataManager.increment(player, "Power", amount)
	Leaderstats.update(player, "Power", DataManager.get(player, "Power"))

	ReplicatedStorage.Events.PowerGainedEvent:FireClient(player, amount)
end

function GameService.handleSell(player)
	local power = DataManager.get(player, "Power") or 0
	if power > 0 then
		local rebirths = DataManager.get(player, "Rebirths") or 0
		local upgradeLevel = (DataManager.get(player, "Upgrades") or {Coins = 1}).Coins
		local upgradeMult = Upgrades.Coins[upgradeLevel].Multiplier
		local petMult = PetService.getEquippedMultiplier(player)
		local zoneMult = ZoneService.getMultiplier(player)

		local multiplier = upgradeMult * petMult * zoneMult

		local coinsGain = power * multiplier
		DataManager.increment(player, "Coins", math.floor(coinsGain))
		DataManager.set(player, "Power", 0)

		Leaderstats.update(player, "Coins", DataManager.get(player, "Coins"))
		Leaderstats.update(player, "Power", 0)
	end
end

function GameService.handleRebirth(player)
	local rebirths = DataManager.get(player, "Rebirths") or 0
	local cost = Constants.REBIRTH_COST_BASE * (Constants.REBIRTH_COST_MULTIPLIER ^ rebirths)
	local coins = DataManager.get(player, "Coins") or 0

	if coins >= cost then
		DataManager.increment(player, "Coins", -cost)
		DataManager.increment(player, "Rebirths", 1)
		DataManager.set(player, "Power", 0)

		Leaderstats.update(player, "Coins", DataManager.get(player, "Coins"))
		Leaderstats.update(player, "Rebirths", DataManager.get(player, "Rebirths"))
		Leaderstats.update(player, "Power", 0)
	end
end

return GameService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="21">
        <Properties>
          <string name="Name">Leaderstats</string>
          <string name="Source"><![CDATA[local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local DataManager = require(script.Parent.DataManager)

local Leaderstats = {}

function Leaderstats.initialize(player)
	local data = DataManager.loadData(player)
	if not data then
		player:Kick("Data failed to load. Please rejoin.")
		return
	end

	local leaderstats = Instance.new("Folder")
	leaderstats.Name = "leaderstats"
	leaderstats.Parent = player

	local coins = Instance.new("IntValue")
	coins.Name = "Coins"
	coins.Value = data.Coins
	coins.Parent = leaderstats

	local power = Instance.new("IntValue")
	power.Name = "Power"
	power.Value = data.Power
	power.Parent = leaderstats

	local rebirths = Instance.new("IntValue")
	rebirths.Name = "Rebirths"
	rebirths.Value = data.Rebirths
	rebirths.Parent = leaderstats
end

function Leaderstats.update(player, key, value)
	local leaderstats = player:FindFirstChild("leaderstats")
	if leaderstats then
		local stat = leaderstats:FindFirstChild(key)
		if stat then
			stat.Value = value
		end
	end
end

return Leaderstats
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="22">
        <Properties>
          <string name="Name">MarketplaceManager</string>
          <string name="Source"><![CDATA[local MarketplaceService = game:GetService("MarketplaceService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Constants = require(ReplicatedStorage.Shared.Constants)
local DataManager = require(script.Parent.DataManager)
local Leaderstats = require(script.Parent.Leaderstats)

local MarketplaceManager = {}

function MarketplaceManager.hasPass(player, passId)
	local success, result = pcall(function()
		return MarketplaceService:UserOwnsGamePassAsync(player.UserId, passId)
	end)
	return success and result
end

-- Example of handling a Developer Product (Buy Coins)
function MarketplaceManager.processReceipt(receiptInfo)
	local player = game:GetService("Players"):GetPlayerByUserId(receiptInfo.PlayerId)
	if not player then return Enum.ProductPurchaseDecision.NotProcessedYet end

	if receiptInfo.ProductId == Constants.MARKETPLACE.BUY_COINS_ID then
		DataManager.increment(player, "Coins", 1000)
		Leaderstats.update(player, "Coins", DataManager.get(player, "Coins"))
		return Enum.ProductPurchaseDecision.PurchaseGranted
	end

	return Enum.ProductPurchaseDecision.NotProcessedYet
end

MarketplaceService.ProcessReceipt = MarketplaceManager.processReceipt

return MarketplaceManager
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="23">
        <Properties>
          <string name="Name">PetService</string>
          <string name="Source"><![CDATA[local ReplicatedStorage = game:GetService("ReplicatedStorage")
local DataManager = require(script.Parent.DataManager)
local PetsConfig = require(ReplicatedStorage.Shared.Pets)
local HttpService = game:GetService("HttpService")

local PetService = {}

local Events = ReplicatedStorage:WaitForChild("Events")
local PetEquippedEvent = Events:WaitForChild("PetEquippedEvent")

function PetService.hatch(player)
	local coins = DataManager.get(player, "Coins")
	if coins >= PetsConfig.Settings.HatchCost then
		DataManager.increment(player, "Coins", -PetsConfig.Settings.HatchCost)

		-- Weighted random selection
		local totalWeight = 0
		for _, pet in ipairs(PetsConfig.List) do
			totalWeight += pet.Weight
		end

		local random = math.random(1, totalWeight)
		local currentWeight = 0
		local chosenPet = nil

		for _, pet in ipairs(PetsConfig.List) do
			currentWeight += pet.Weight
			if random <= currentWeight then
				chosenPet = pet
				break
			end
		end

		if chosenPet then
			local pets = DataManager.get(player, "Pets") or {}
			local newPet = {
				Id = HttpService:GenerateGUID(),
				Name = chosenPet.Name,
				Multiplier = chosenPet.Multiplier,
				Rarity = chosenPet.Rarity
			}
			table.insert(pets, newPet)
			DataManager.set(player, "Pets", pets)

			-- Auto-equip if space
			local equipped = DataManager.get(player, "EquippedPets") or {}
			if #equipped < PetsConfig.Settings.MaxEquipped then
				PetService.equip(player, newPet.Id)
			end

			return newPet
		end
	end
end

function PetService.equip(player, petId)
	local pets = DataManager.get(player, "Pets") or {}
	local equipped = DataManager.get(player, "EquippedPets") or {}

	local found = false
	for _, pet in ipairs(pets) do
		if pet.Id == petId then
			found = true
			break
		end
	end

	if found then
		-- Simple logic: if already equipped, unequip. If not, equip if space.
		local index = table.find(equipped, petId)
		if index then
			table.remove(equipped, index)
		else
			if #equipped < PetsConfig.Settings.MaxEquipped then
				table.insert(equipped, petId)
			end
		end
		DataManager.set(player, "EquippedPets", equipped)

		-- Notify client of changes
		local equippedPetData = {}
		for _, id in ipairs(equipped) do
			for _, pet in ipairs(pets) do
				if pet.Id == id then
					table.insert(equippedPetData, pet)
				end
			end
		end
		PetEquippedEvent:FireClient(player, equippedPetData)
	end
end

function PetService.getEquippedMultiplier(player)
	local equipped = DataManager.get(player, "EquippedPets") or {}
	local multiplier = 1
	for _, petId in ipairs(equipped) do
		local pets = DataManager.get(player, "Pets") or {}
		for _, pet in ipairs(pets) do
			if pet.Id == petId then
				multiplier += (pet.Multiplier - 1)
			end
		end
	end
	return multiplier
end

return PetService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="24">
        <Properties>
          <string name="Name">ZoneService</string>
          <string name="Source"><![CDATA[local ReplicatedStorage = game:GetService("ReplicatedStorage")
local DataManager = require(script.Parent.DataManager)
local Zones = require(ReplicatedStorage.Shared.Zones)

local ZoneService = {}

local Events = ReplicatedStorage:WaitForChild("Events")
local UnlockZoneEvent = Events:WaitForChild("UnlockZoneEvent")
local ZoneChangedEvent = Events:WaitForChild("ZoneChangedEvent")

function ZoneService.unlockNext(player)
	local unlocked = DataManager.get(player, "UnlockedZones")
	local nextZoneIndex = #unlocked + 1
	local nextZone = Zones[nextZoneIndex]

	if nextZone then
		local coins = DataManager.get(player, "Coins")
		if coins >= nextZone.UnlockCost then
			DataManager.increment(player, "Coins", -nextZone.UnlockCost)
			table.insert(unlocked, nextZone.Name)
			DataManager.set(player, "UnlockedZones", unlocked)

			-- Automatically move to the new zone
			ZoneService.setCurrentZone(player, nextZone.Name)
			ZoneService.updateVisuals(player)
			return true
		end
	end
	return false
end

function ZoneService.updateVisuals(player)
	local unlocked = DataManager.get(player, "UnlockedZones")
	local hasZone2 = false
	for _, name in ipairs(unlocked) do
		if name == "Zone 2" then
			hasZone2 = true
			break
		end
	end

	if hasZone2 then
		local gate = workspace:FindFirstChild("Gate")
		if gate then
			gate.CanCollide = false
			gate.Transparency = 1
		end
	end
end

function ZoneService.setCurrentZone(player, zoneName)
	local unlocked = DataManager.get(player, "UnlockedZones")
	local isUnlocked = false
	for _, name in ipairs(unlocked) do
		if name == zoneName then
			isUnlocked = true
			break
		end
	end

	if isUnlocked then
		DataManager.set(player, "CurrentZone", zoneName)
		ZoneChangedEvent:FireClient(player, zoneName)
	end
end

function ZoneService.getMultiplier(player)
	local currentZoneName = DataManager.get(player, "CurrentZone")
	for _, zone in ipairs(Zones) do
		if zone.Name == currentZoneName then
			return zone.Multiplier
		end
	end
	return 1
end

UnlockZoneEvent.OnServerEvent:Connect(function(player)
	ZoneService.unlockNext(player)
end)

return ZoneService
]]></string>
        </Properties>
      </Item>
    </Item>
