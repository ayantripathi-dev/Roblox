            <string name="Name">Constants</string>
            <string name="Source"><![CDATA[local Constants = {
	INITIAL_POWER = 0,
	INITIAL_COINS = 0,
	INITIAL_REBIRTHS = 0,

	CLICK_POWER_GAIN = 1,

	REBIRTH_COST_BASE = 1000,
	REBIRTH_COST_MULTIPLIER = 2.5,

	UPGRADE_COST_BASE = 100,
	UPGRADE_COST_MULTIPLIER = 1.5,

	MARKETPLACE = {
		DOUBLE_COINS_ID = 1234567, -- Placeholder
		BUY_COINS_ID = 7654321,   -- Placeholder
	}
}

return Constants
]]></string>
