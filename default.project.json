{
  "name": "SuperSimulator",
  "tree": {
    "$className": "DataModel",
    "ReplicatedStorage": {
      "Shared": {
        "$path": "src/shared"
      },
      "Events": {
        "$className": "Folder",
        "ClickEvent": {
          "$className": "RemoteEvent"
        },
        "RebirthEvent": {
          "$className": "RemoteEvent"
        }
      }
    },
    "ServerScriptService": {
      "Server": {
        "$path": "src/server"
      }
    },
    "StarterPlayer": {
      "StarterPlayerScripts": {
        "Client": {
          "$path": "src/client"
        }
      }
    },
    "Workspace": {
      "Baseplate": {
        "$className": "Part",
        "$properties": {
          "Size": [512, 2, 512],
          "Position": [0, -1, 0],
          "Anchored": true
        }
      },
      "SellPart": {
        "$className": "Part",
        "$properties": {
          "Size": [10, 1, 10],
          "Position": [20, 0, 20],
          "Anchored": true
        }
      }
    },
    "StarterGui": {
      "MainHUD": {
        "$className": "ScreenGui",
        "HUDFrame": {
          "$className": "Frame",
          "PowerLabel": {
            "$className": "TextLabel",
            "$properties": {
              "Text": "Power: 0"
            }
          },
          "CoinsLabel": {
            "$className": "TextLabel",
            "$properties": {
              "Text": "Coins: 0"
            }
          }
        },
        "ClickButton": {
          "$className": "TextButton",
          "$properties": {
            "Text": "CLICK ME!"
          }
        },
        "RebirthButton": {
          "$className": "TextButton",
          "$properties": {
            "Text": "REBIRTH"
          }
        }
      }
    }
  }
}
