{
  "name": "SuperSimulator",
  "tree": {
    "$className": "DataModel",
    "ReplicatedStorage": {
      "Shared": {
        "$path": "src/shared"
      },
      "Events": {
        "$className": "Folder",
        "ClickEvent": {
          "$className": "RemoteEvent"
        },
        "RebirthEvent": {
          "$className": "RemoteEvent"
        },
        "UpgradeEvent": {
          "$className": "RemoteEvent"
        },
        "PetHatchEvent": {
          "$className": "RemoteEvent"
        },
        "UnlockZoneEvent": {
          "$className": "RemoteEvent"
        },
        "ZoneChangedEvent": {
          "$className": "RemoteEvent"
        },
        "PetEquippedEvent": {
          "$className": "RemoteEvent"
        },
        "PowerGainedEvent": {
          "$className": "RemoteEvent"
        }
      }
    },
    "ServerScriptService": {
      "Server": {
        "$path": "src/server"
      }
    },
    "StarterPlayer": {
      "StarterPlayerScripts": {
        "Client": {
          "$path": "src/client"
        }
      }
    },
    "Workspace": {
      "Baseplate": {
        "$className": "Part",
        "$properties": {
          "Size": [512, 2, 512],
          "Position": [0, -1, 0],
          "Anchored": true
        }
      },
      "SellPart": {
        "$className": "Part",
        "$properties": {
          "Size": [10, 1, 10],
          "Position": [20, 0, 20],
          "Anchored": true
        }
      },
      "Zone2": {
        "$className": "Part",
        "$properties": {
          "Size": [512, 2, 512],
          "Position": [550, -1, 0],
          "Anchored": true,
          "Color": [0.39, 0.39, 1]
        }
      },
      "Gate": {
        "$className": "Part",
        "$properties": {
          "Size": [10, 50, 100],
          "Position": [256, 25, 0],
          "Anchored": true,
          "Transparency": 0.5
        }
      }
    },
    "StarterGui": {
      "MainHUD": {
        "$className": "ScreenGui",
        "HUDFrame": {
          "$className": "Frame",
          "PowerLabel": {
            "$className": "TextLabel",
            "$properties": { "Text": "Power: 0" }
          },
          "CoinsLabel": {
            "$className": "TextLabel",
            "$properties": { "Text": "Coins: 0" }
          }
        },
        "Buttons": {
          "$className": "Folder",
          "ClickButton": {
            "$className": "TextButton",
            "$properties": { "Text": "CLICK ME!" }
          },
          "RebirthButton": {
            "$className": "TextButton",
            "$properties": { "Text": "REBIRTH" }
          },
          "UpgradeButton": {
            "$className": "TextButton",
            "$properties": { "Text": "UPGRADES" }
          },
          "PetButton": {
            "$className": "TextButton",
            "$properties": { "Text": "HATCH PET (500)" }
          }
        }
      }
    }
  }
}
